        "fields": [
          {
            "name": "device_type",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "operating_system",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "browser",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "payload",
      "type": {
        "type": "record",
        "name": "SearchPayload",
