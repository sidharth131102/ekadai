        "namespace": "ekadai.events.common",
        "fields": [
          {
            "name": "user_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          },
          {
            "name": "session_id",
            "type": [
              "null",
              "string"
            ],
            "default": null
          }
        ]
      }
    },
    {
