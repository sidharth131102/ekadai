# --- PostgreSQL (Phase 1) ---
# Local dev (matches db/docker-compose.yml). Point this at Supabase later by swapping
# only this value — schema/migrations/app code are environment-agnostic.
DATABASE_URL=postgresql+psycopg://ekadai:ekadai@localhost:5432/ekadai

# Individual components (used by docker-compose.yml)
POSTGRES_USER=ekadai
POSTGRES_PASSWORD=ekadai
POSTGRES_DB=ekadai
POSTGRES_PORT=5432

# --- Backend API (Phase 2a) ---
# Dev-only default — override for anything beyond localhost.
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
DEFAULT_CURRENCY=INR

# Separate database for the test suite (tests/app) — never the dev DB.
TEST_DATABASE_URL=postgresql+psycopg://ekadai:ekadai@localhost:5432/ekadai_test

# --- Kafka + Schema Registry (Phase 4, local via kafka/docker-compose.yml) ---
# Defaults keep EVENT_TRANSPORT=logging (Phase 3a's LoggingTransport, var/events.log) so a
# fresh clone never requires Kafka to be running. Uncomment to produce real Avro events instead.
# EVENT_TRANSPORT=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Later phases (not used yet, documented for forward reference) ---
# SUPABASE_DB_URL=
# DATABRICKS_HOST=
# DATABRICKS_TOKEN=
