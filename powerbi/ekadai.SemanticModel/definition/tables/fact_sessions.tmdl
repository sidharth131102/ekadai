table fact_sessions
	lineageTag: 7a33879e-f94a-4a5a-8a3a-c7e17ce3e79c

	measure Sessions = COUNTROWS('fact_sessions')
		formatString: #,0
		lineageTag: b25b8424-263c-4b01-ac17-583636bd7bf6

	measure 'Converted Sessions' = CALCULATE(COUNTROWS('fact_sessions'), 'fact_sessions'[converted] = TRUE())
		formatString: #,0
		lineageTag: db2d93f3-476b-49d4-b09f-8bd5a9c86d29

	measure 'Session Conversion %' = DIVIDE([Converted Sessions], [Sessions])
		formatString: 0.0%
		lineageTag: b827e2cf-8980-45c4-a64e-f27b4dd79ed1

	measure 'Avg Session Minutes' = AVERAGE('fact_sessions'[session_duration_seconds]) / 60
		formatString: #,0.0
		lineageTag: c3a73931-314c-49c4-96aa-284b7ba5664f

	measure 'Returning Users' = COUNTROWS(FILTER(VALUES('fact_sessions'[user_key]), NOT ISBLANK('fact_sessions'[user_key]) && CALCULATE(DISTINCTCOUNT('fact_sessions'[date_key])) > 1))
		formatString: #,0
		lineageTag: 62983a8b-ea06-471f-bcbf-7c7285820e65

