table agg_order_metrics
	lineageTag: f1c30dc4-d097-4f86-9b28-3578565dd3bf

	measure Orders = SUM('agg_order_metrics'[order_count])
		formatString: #,0
		lineageTag: a3469826-0e84-409b-9759-4d3f4b59f9d1

	measure 'Confirmed Orders' = SUM('agg_order_metrics'[confirmed_order_count])
		formatString: #,0
		lineageTag: 1e4906fe-cd2d-443d-92b5-f0c895ec6979

	measure 'Cancelled Orders' = SUM('agg_order_metrics'[cancelled_order_count])
		formatString: #,0
		lineageTag: f7fd07cc-75a8-43c5-b538-752541583396

	measure AOV = DIVIDE(SUM('agg_order_metrics'[total_order_value]), [Orders])
		formatString: ₹#,0.00
		lineageTag: 946e9447-cc6a-4f86-92f8-5ed31903c335

	measure 'Cancellation Rate' = DIVIDE([Cancelled Orders], [Orders])
		formatString: 0.0%
		lineageTag: 9a952fb7-d884-4f61-98c6-8aee1c16ee91

