table agg_conversion_funnel
	lineageTag: fbe3a532-70da-480e-817a-f6dd4af0a748

	measure 'Funnel 1 Product View' = SUM('agg_conversion_funnel'[product_view_sessions])
		formatString: #,0
		lineageTag: d4f43f23-8aeb-4d24-b1dc-cc981571bccf

	measure 'Funnel 2 Add To Cart' = SUM('agg_conversion_funnel'[add_to_cart_sessions])
		formatString: #,0
		lineageTag: 310f2f0e-b167-40ad-8c6d-19a7d3a733f3

	measure 'Funnel 3 Checkout' = SUM('agg_conversion_funnel'[checkout_started_sessions])
		formatString: #,0
		lineageTag: 499011ae-16c2-4973-90f4-2dfc543bf419

	measure 'Funnel 4 Successful Order' = SUM('agg_conversion_funnel'[successful_order_sessions])
		formatString: #,0
		lineageTag: 2576f512-4739-4426-b1ff-e8fe49e0fc96

	measure 'View to Cart %' = DIVIDE([Funnel 2 Add To Cart], [Funnel 1 Product View])
		formatString: 0.0%
		lineageTag: 61084af3-96ea-4ad9-824b-abd8c9428766

	measure 'Cart to Checkout %' = DIVIDE([Funnel 3 Checkout], [Funnel 2 Add To Cart])
		formatString: 0.0%
		lineageTag: 7b9fa89b-2cd1-49de-b25a-05a00902f629

	measure 'Checkout to Order %' = DIVIDE([Funnel 4 Successful Order], [Funnel 3 Checkout])
		formatString: 0.0%
		lineageTag: 6149fed4-f730-4290-9464-718827020f57

	measure 'Checkout Abandonment %' = DIVIDE(SUM('agg_conversion_funnel'[checkout_abandoned_sessions]), [Funnel 3 Checkout])
		formatString: 0.0%
		lineageTag: 8401ebf8-60bf-4a72-82c3-fbc40c342beb

	measure 'Cancelled Order Sessions' = SUM('agg_conversion_funnel'[cancelled_order_sessions])
		formatString: #,0
		lineageTag: 9387e278-a4b4-42b9-b27f-f0dcc1366101

